#include <algorithm>
#include <iostream>
#include <set>
#include <string>
#include <utility>
#include <vector>

using namespace std;

class OrderedPairGame {
  private:
    vector<string> setA;
    vector<string> setB;
    set<pair<string, string>> submittedPairs;

    vector<pair<string, string>> buildCartesianProduct() const {
        vector<pair<string, string>> product;
        for (const string &a : setA) {
            for (const string &b : setB) {
                product.push_back({a, b});
            }
        }
        return product;
    }

  public:
    void setupSets() {
        int sizeA, sizeB;

        cout << "=== Cartesian Product Challenge ===\n";
        cout << "How many elements should Set A have? ";
        cin >> sizeA;

        cout << "How many elements should Set B have? ";
        cin >> sizeB;

        setA.resize(sizeA);
        setB.resize(sizeB);

        cout << "\nEnter elements for Set A:\n";
        for (int i = 0; i < sizeA; i++) {
            cout << "A[" << i + 1 << "]: ";
            cin >> setA[i];
        }

        cout << "\nEnter elements for Set B:\n";
        for (int i = 0; i < sizeB; i++) {
            cout << "B[" << i + 1 << "]: ";
            cin >> setB[i];
        }

        cout << "\nGreat! You now need to guess every ordered pair (a,b).\n";
        cout << "Type each answer as two strings separated by a space.\n";
    }

    void playRound() {
        vector<pair<string, string>> answerKey = buildCartesianProduct();
        int totalPairs = static_cast<int>(answerKey.size());

        cout << "\nTotal pairs to find: " << totalPairs << "\n";

        while (static_cast<int>(submittedPairs.size()) < totalPairs) {
            string a, b;
            cout << "Enter pair #" << submittedPairs.size() + 1 << ": ";
            cin >> a >> b;

            pair<string, string> current = {a, b};

            if (find(answerKey.begin(), answerKey.end(), current) == answerKey.end()) {
                cout << "❌ Not part of A x B. Try again.\n";
                continue;
            }

            if (submittedPairs.count(current)) {
                cout << "⚠️  You already entered that pair.\n";
                continue;
            }

            submittedPairs.insert(current);
            cout << "✅ Correct! " << submittedPairs.size() << "/" << totalPairs << " found.\n";
        }

        cout << "\n🎉 You completed the Cartesian product!\n";
        cout << "Final set: { ";
        for (int i = 0; i < totalPairs; i++) {
            cout << "(" << answerKey[i].first << "," << answerKey[i].second << ")";
            if (i + 1 < totalPairs) {
                cout << ", ";
            }
        }
        cout << " }\n";
    }
};

int main() {
    OrderedPairGame game;
    game.setupSets();
    game.playRound();
    return 0;
}
